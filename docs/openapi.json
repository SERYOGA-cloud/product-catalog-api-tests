{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "description": "Configurable API server base URL (passed via BASE_URL)"
    }
  ],
  "paths": {
    "/api/product/{code}": {
      "get": {
        "tags": [
          "catalog-controller"
        ],
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Код продукта для поиска,gtin или ntinCode",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
    "/api/product/download/time/": {
      "delete": {
        "tags": [
          "catalog-controller"
        ],
        "summary": "Очистка временной метки времени загрузки продукта",
        "operationId": "downloadTime",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/product/download/link/": {
      "delete": {
        "tags": [
          "catalog-controller"
        ],
        "summary": "Очистка текущей ссылки на загрузку продукта",
        "operationId": "downloadLink",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Measure": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "short_name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name_ru": {
            "type": "string"
          },
          "name_kk": {
            "type": "string"
          },
          "gtin": {
            "type": "string"
          },
          "ntin_code": {
            "type": "string"
          },
          "is_social": {
            "type": "boolean"
          },
          "modified": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "is_markedeac": {
            "type": "boolean"
          },
          "measure": {
            "$ref": "#/components/schemas/Measure"
          },
          "ntin_isdeactivated": {
            "type": "boolean"
          },
          "ntin_deactivationreason": {
            "type": "string"
          },
          "ntin_duplicateofproduct": {
            "type": "string"
          }
        }
      }
    }
  }
}
