# ==============================================================================
# Product Catalog API Automation Framework — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (which is ignored by Git) and fill in the values
# for your target environment, or export these variables in your shell / CI secrets.
# Never commit real URLs, tokens, or credentials to version control.

# [REQUIRED] Base URL of the target Product Catalog API service
BASE_URL=

# [REQUIRED] URL of the Swagger UI page, OpenAPI JSON/YAML endpoint, or local spec path
SWAGGER_URL=

# [OPTIONAL] Authentication configuration (NONE | BEARER | API_KEY | BASIC)
AUTH_TYPE=NONE
API_TOKEN=
API_HEADER_NAME=X-API-Key
API_USERNAME=
API_PASSWORD=

# [OPTIONAL] Connection and socket read timeouts (in milliseconds)
CONNECT_TIMEOUT_MS=5000
READ_TIMEOUT_MS=15000

# [OPTIONAL] Safety guard for state-modifying DELETE /api/product/download/* tests
ALLOW_DESTRUCTIVE_TESTS=false

# [OPTIONAL] Run against built-in local OpenAPI WireMock contract stub (true | false)
USE_LOCAL_MOCK=false

# [OPTIONAL] Test product codes (GTIN / NTIN) for the target stand
TEST_ACTIVE_GTIN=1234567890123
TEST_ACTIVE_NTIN=0200208079406
TEST_INACTIVE_GTIN=4870207999999
TEST_DEACTIVATED_NTIN=0290000099999
